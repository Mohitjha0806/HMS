<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <meta charset="utf-8" />
    <title>HMS - Hospital Managemet System</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta content="HMS - Hospital Managemet System" name="description" />
    <meta content="HMS" name="author" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" rel="stylesheet" />
    <link rel="shortcut icon" href="~/assets/images/new-fav-icon-removebg-preview.png">
    <link rel="shortcut icon" src="~/img/new-fav-icon-removebg-preview.png" />
    <link href="~/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/file-upload.css" rel="stylesheet" />
    <link href="~/css/select2.min.css" rel="stylesheet" />
    <link href="~/css/style.min.css" rel="stylesheet" />
    <link href="~/css/sweetalert2.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
    <link href="~/css/aos.css" rel="stylesheet" />
    <link href="~/libs/jsvectormap/css/jsvectormap.min.css" rel="stylesheet" type="text/css" />
    <link href="~/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link href="~/css/icons.min.css" rel="stylesheet" type="text/css" />
    <link href="~/css/app.min.css" rel="stylesheet" type="text/css" />
    <link href="~/css/custom.min.css" rel="stylesheet" type="text/css" />
    <link href="~/css/mainmaster.css" rel="stylesheet" />
</head>
<body>
    <div id="layout-wrapper">
        <header id="page-topbar">
            <div class="layout-width">
                <div class="navbar-header">
                    <div class="d-flex">
                        <div class="navbar-brand-box horizontal-logo">
                           
                            <a href="/mis/Dashboard/AdminDashboard.aspx" class="logo logo-light">
                                <span class="logo-sm">
                                    <img src="~/images/v987-18a-removebg-preview.png" alt="" height="50">
                                </span>
                                <span class="logo-lg">

                                    <img src="~/images/v987-18a-removebg-preview.png" alt="" height="35">
                                </span>

                            </a>
                        </div>

                        <button type="button" class="btn  btn-sm px-3 fs-16 header-item vertical-menu-btn  material-shadow-none" id="topnav-hamburger-icon">
                            <span class="hamburger-icon sidebar-toggle open">
                                <span></span>
                                <span></span>
                                <span></span>
                            </span>
                        </button>
                        <div class="dropdown topbar-head-dropdown header-item">
                            <h4>Hospital Managemet System</h4>
                        </div>
                    </div>

                    <div class="d-flex  align-items-center">

                        <div class="dropdown ms-sm-3 header-item topbar-user">
                            <button type="button" class="btn material-shadow-none" id="page-header-user-dropdown" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <span class="d-flex align-items-center">
                                    <img class="rounded-circle header-profile-user" src="~/images/users/avatar-1.jpg" alt="Header Avatar">
                                    <span class="text-start ms-xl-2">
                                        <span class="d-none d-xl-inline-block ms-1 fw-semibold user-name-text">User</span>
                                        <span class="d-none d-xl-block ms-1 fs-12 fw-semibold user-name-sub-text">School</span>
                                    </span>
                                </span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end">
                                <h6 class="dropdown-header">Welcome User!</h6>
                                <a class="nav-link" href="#"><i class="mdi mdi-account-circle text-muted fs-16 align-middle me-1"></i><span class="align-middle">Profile</span></a>
                                <div class="dropdown-divider"></div>
                                <a asp-action="Index" asp-controller="Login" class="nav-link"><i class="mdi mdi-logout text-muted fs-16 align-middle me-1"></i><span class="align-middle" data-key="t-logout">Logout</span></a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </header>
        <div id="removeNotificationModal" class="modal fade zoomIn" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" id="NotificationModalbtn-close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mt-2 text-center">
                            <div class="mt-4 pt-2 fs-15 mx-4 mx-sm-5">
                                <h4>Are you sure ?</h4>
                                <p class="text-muted mx-4 mb-0">Are you sure you want to remove this Notification ?</p>
                            </div>
                        </div>
                        <div class="d-flex gap-2 justify-content-center mt-4 mb-2">
                            <button type="button" class="btn w-sm btn-light" data-bs-dismiss="modal">Close</button>
                            <button type="button" class="btn w-sm btn-danger" id="delete-notification">Yes, Delete It!</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="app-menu navbar-menu">
            <div class="navbar-brand-box badge-gradient-warning">
                <div class="row d-flex align-items-center justify-content-center">
                    <div class="col-md-5 text-end">
                        <img src="~/images/v987-18a-removebg-preview.png" alt="" height="70">
                    </div>
                    <div class="col-md-6 d-flex align-items-center text-start">
                        <h1 class="text-primary fw-bold">HMS</h1>
                    </div>
                </div>
                <button type="button" class="btn btn-sm p-0 fs-20 header-item float-end btn-vertical-sm-hover" id="vertical-hover">
                    <i class="ri-record-circle-line"></i>
                </button>
            </div>
            <div class="dropdown sidebar-user m-1 rounded">
                <button type="button" class="btn material-shadow-none" id="page-header-user-dropdown" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <span class="d-flex align-items-center gap-2">
                        <img class="rounded header-profile-user" src="~/images/users/avatar-1.jpg" alt="Header Avatar">
                        <span class="text-start">
                            <span class="d-block fw-medium sidebar-user-name-text">User</span>
                            <span class="d-block fs-14 sidebar-user-name-sub-text"><i class="ri ri-circle-fill fs-10 text-success align-baseline"></i><span class="align-middle">Online</span></span>
                        </span>
                    </span>
                </button>
                <div class="dropdown-menu dropdown-menu-end">
                    <h6 class="dropdown-header">Welcome User!</h6>
                    <a class="nav-link" href="pages-profile.html"><i class="mdi mdi-account-circle text-muted fs-16 align-middle me-1"></i><span class="align-middle">Profile</span></a>
                    <div class="dropdown-divider"></div>
                    <a class="nav-link" href="auth-lockscreen-basic.html"><i class="mdi mdi-lock text-muted fs-16 align-middle me-1"></i><span class="align-middle">Lock screen</span></a>
                    <a class="nav-link" href="auth-logout-basic.html"><i class="mdi mdi-logout text-muted fs-16 align-middle me-1"></i><span class="align-middle" data-key="t-logout">Logout</span></a>
                </div>
            </div>
            <div id="scrollbar">
                <div class="container-fluid">
                    <div id="two-column-menu">
                    </div>
                    <ul class="navbar-nav" id="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link menu-link" href="#sidebarHome" data-bs-toggle="collapse" role="button" aria-expanded="false" aria-controls="sidebarHome">
                                <i class="ri-stack-line"></i><span data-key="t-sidebarHome">Home</span>
                            </a>
                            <div class="collapse menu-dropdown" id="sidebarHome">
                                <ul class="nav nav-sm flex-column">
                                    <li class="nav-item"><a asp-action="Index" asp-controller="Home" class="nav-link"><i class="fa-solid fa-house-chimney fs-6"></i>Home</a></li>
                                </ul>
                            </div>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link menu-link" href="#sidebarHospitalRegistration" data-bs-toggle="collapse" role="button" aria-expanded="false" aria-controls="sidebarHospitalRegistration">
                                <i class="ri-stack-line"></i><span data-key="t-sidebarHospitalRegistration">Hospital Master</span>
                            </a>
                            <div class="collapse menu-dropdown" id="sidebarHospitalRegistration">
                                <ul class="nav nav-sm flex-column">
                                    <li class="nav-item"><a asp-action="Create" asp-controller="MstHospitalRegistration" class="nav-link"><i class="fa-solid fa-plus fs-5"></i>Register New Hospital</a></li>
                                </ul>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="sidebar-background"></div>
        </div>
        <div class="vertical-overlay"></div>
        <div class="main-content">
            <div class="page-content">
                <div class="container-fluid">
                    @RenderBody()
                </div>

            </div>
        </div>
        <footer class="footer">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-sm-6">
                        © Hospital Managemet System.
                    </div>
                    <div class="col-sm-6">
                        <div class="text-sm-end d-none d-sm-block">
                            Design & Develop by<span style="color: darkblue;"> SFA</span>
                        </div>
                    </div>
                </div>
            </div>
        </footer>
    </div>
    <button onclick="topFunction()" type="button" class="btn btn-danger btn-icon" id="back-to-top">
        <i class="ri-arrow-up-line"></i>
    </button>
    <script src="~/js/jquery.min.js"></script>
    <script src="~/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/libs/simplebar/simplebar.min.js"></script>
    <script src="~/libs/node-waves/waves.min.js"></script>
    <script src="~/libs/feather-icons/feather.min.js"></script>
    <script src="~/js/pages/plugins/lord-icon-2.1.0.js"></script>
    <script src="~/js/plugins.js"></script>
    <script src="~/libs/apexcharts/apexcharts.min.js"></script>
    <script src="~/libs/jsvectormap/js/jsvectormap.min.js"></script>
    <script src="~/libs/jsvectormap/maps/world-merc.js"></script>
    <script src="~/js/pages/dashboard-analytics.init.js"></script>
    <script src="~/js/layout.js"></script>
    <script src="~/js/app.js"></script>
    <script src="~/js/pages/dashboard-ecommerce.init.js"></script>
    <script src="~/js/pages/calendar-month-grid.init.js"></script>
    <script src="~/libs/fullcalendar/index.global.min.js"></script>
    <script src="~/js/custom.js"></script>
    <script src="~/js/custom.min.js"></script>
    <script src="~/js/select2.full.min.js"></script>
    <script src="~/js/sweet-alert.init.js"></script>
    <script src="~/js/sweetalert2.all.min.js"></script>
    <script src="~/js/aos.js"></script>
    <script src="~/js/mainmaster.js"></script>
</body>
</html>
