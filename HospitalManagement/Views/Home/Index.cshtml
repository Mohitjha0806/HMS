@{
    ViewData["Title"] = "Hospital Management Dashboard";
    Layout = "~/Views/Shared/_MainMaster.cshtml";
}

<style>
    .chart-container {
        width: 100%;
        height: 300px;
    }
</style>


<div class="card">
    <div class="card-header">
        <h1 class="text-center">Hospital Management Dashboard</h1>

    </div>
    <div class="card-body border-1">
        <div class="row">
            <div class="col-md-6">
                <div id="admissionChart" class="chart-container"></div>
            </div>
            <div class="col-md-6">
                <div id="revenueChart" class="chart-container"></div>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-md-6">
                <div id="staffChart" class="chart-container"></div>
            </div>
            <div class="col-md-6">
                <div id="appointmentsChart" class="chart-container"></div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/highcharts/highcharts.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        Highcharts.chart('admissionChart', {
            chart: { type: 'column' },
            title: { text: 'Patient Admissions' },
            xAxis: { categories: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'] },
            yAxis: { title: { text: 'Admissions' } },
            series: [{
                name: 'Admissions',
                data: [120, 150, 130, 170, 190, 210],
                color: 'rgba(54, 162, 235, 0.6)'
            }]
        });

        Highcharts.chart('revenueChart', {
            chart: { type: 'line' },
            title: { text: 'Revenue (in lakhs)' },
            xAxis: { categories: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'] },
            yAxis: { title: { text: 'Revenue' } },
            series: [{
                name: 'Revenue',
                data: [30, 45, 40, 55, 70, 85], 
                color: 'rgba(255,99,132,1)'
            }]
        });

        Highcharts.chart('staffChart', {
            chart: { type: 'pie' },
            title: { text: 'Staff Distribution' },
            series: [{
                name: 'Staff Count',
                data: [
                    { name: 'Doctors', y: 35 },
                    { name: 'Nurses', y: 50 },
                    { name: 'Technicians', y: 25 },
                    { name: 'Administration', y: 20 }
                ]
            }]
        });

        Highcharts.chart('appointmentsChart', {
            chart: { type: 'bar' },
            title: { text: 'Appointments vs Walk-ins' },
            xAxis: { categories: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'] },
            yAxis: { title: { text: 'Patients' } },
            series: [{
                name: 'Appointments',
                data: [90, 85, 80, 95, 100, 110],
                color: 'rgba(75, 192, 192, 0.6)'
            }, {
                name: 'Walk-ins',
                data: [40, 50, 45, 60, 70, 75],
                color: 'rgba(255, 159, 64, 0.6)'
            }]
        });
    });
</script>