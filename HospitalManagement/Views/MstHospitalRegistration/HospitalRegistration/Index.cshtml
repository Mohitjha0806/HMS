@{
    Layout = "~/Views/Shared/_MainMaster.cshtml";
}
<div class="card card-border-primary">
    <div class="card-header">
        <div class="row px-2">
            <div class="col-md-6">
                <h4 class="card-title">
                    Hospitals List
                </h4>
            </div>
            <div class="col-md-6 text-end">
                <a asp-action="Create" asp-controller="MstHospitalRegistration" class="btn btn-primary shadow sharp me-1">
                    Go Back
                </a>
            </div>
        </div>
    </div>
    <div class="card-body">
        <div class="row px-3">
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover">
                    <thead class="table-primary">
                        <tr>
                            <th>S.No.</th>
                            <th>Hospital Name</th>
                            <th>Hospital Type</th>
                            <th>Owner Name</th>
                            <th>Medical License Number</th>
                            <th>Staff Count</th>
                            <th>Address</th>
                            <th>Email</th>
                            <th>Contact Number</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>1</td>
                            <td>Hospital A</td>
                            <td>General</td>
                            <td>Owner A</td>
                            <td>MLN12345</td>
                            <td>150</td>
                            <td>123 Street, City</td>
                            <td>hospitalA@example.com</td>
                            <td>1234567890</td>
                        </tr>
                        <tr>
                            <td>2</td>
                            <td>Hospital B</td>
                            <td>Specialty</td>
                            <td>Owner B</td>
                            <td>MLN67890</td>
                            <td>200</td>
                            <td>456 Avenue, Town</td>
                            <td>hospitalB@example.com</td>
                            <td>9876543210</td>
                        </tr>
                        <!-- Add more rows as needed -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
