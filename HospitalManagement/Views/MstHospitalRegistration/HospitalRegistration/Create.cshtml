@using HospitalManagement.Entities.Models
@{
    Layout = "~/Views/Shared/_MainMaster.cshtml";
}

@model HospitalManagement.Entities.Models.MstHospitalRegistration
@{
    var hospitalTypes = ViewBag.HospitalTypes as List<HospitalTypeModel>;
}
<script>
    window.onload = function () {
            if ("@TempData["Message"]" != "") {
            const alertText = GetDefaultText();
            if ("@TempData["Type"]" === alertText.successCode) {
            showSwal(alertText.alertType, alertText.successCodeIcon, alertText.successCodeBtnTxt, alertText.successCodeHeaderMsg, "@TempData["Message"]");
            }
            if ("@TempData["Type"]" === alertText.warningCode) {
            showSwal(alertText.alertType, alertText.warningCodeIcon, alertText.warningCodeBtnTxt, alertText.warningCodeHeaderMsg, "@TempData["Message"]");
            }
            if ("@TempData["Type"]" === alertText.errorCode) {
            showSwal(alertText.alertType, alertText.errorCodeIcon, alertText.errorCodeBtnTxt, alertText.errorCodeHeaderMsg, "@TempData["Message"]");
            }
            if ("@TempData["Type"]" === alertText.WarningCode) {
            showSwal(alertText.alertType, alertText.WarningCodeIcon, alertText.WarningCodeBtnTxt, alertText.InvalidCodeHeaderMsg, "@TempData["Message"]");
            }
        }
    }
</script>

<div class="card card-border-primary">
    <div class="card-header">
        <div class="row px-2">
            <div class="col-md-6">
                <h4 class="card-title">
                    Register Your Hospital
                </h4>
            </div>
            <div class="col-md-6 text-end">
                <a asp-action="Index" asp-controller="MstHospitalRegistration" class="btn btn-primary shadow sharp me-1">
                    <i class="fa-solid fa-backward"></i>&nbsp;&nbsp;Go Back
                </a>
            </div>
        </div>
    </div>
    <div class="card-body">
        <form asp-action="CreatePost" id="formCreate" method="post" autocomplete="off">
            <div class="form-group">
                <div class="row px-3">
                    <div class="col-md-3 px-2">
                        <label class="form-label">Enter Hospital Name</label>
                        <input type="text" class="form-control" id="txtHospitalName" placeholder="Enter Name" asp-for="HospitalName" required />
                    </div>
                    <div class="col-md-3 px-2">
                        <label class="form-label">Select Hospital Type</label>
                        <select class="form-select" id="hospitalTypeDropdown" asp-for="HospitalTypeId" asp-items="ViewBag.hospitalTypes" required>
                            <option selected disabled>Choose...</option>
                        </select>
                    </div>
                    <div class="col-md-3 px-2">
                        <label class="form-label">Enter Owner Name</label>
                        <input type="text" class="form-control" id="txtOwnerName" maxlength="50" placeholder="Owner Name" asp-for="OwnerName" required />
                    </div>
                    <div class="col-md-3 px-2">
                        <label class="form-label">Enter Medical License Number</label>
                        <input id="txtMedicalLicenseNumber" type="text" pattern="[1-9]{1}[0-9]{9}" class="form-control" maxlength="10" placeholder="Medical License Number" asp-for="MedicalLicenseNumber" required />
                    </div>
                </div>
                <div class="row px-3">
                    <div class="col-md-3 px-2">
                        <label class="form-label">Enter Staff Count</label>
                        <input id="txtStaffCount" type="number" min="0" max="50" class="form-control" placeholder="Enter Count" asp-for="StaffCount" required />
                    </div>
                    <div class="col-md-3 px-2">
                        <label class="form-label">Enter Hospital Address</label>
                        <input id="HospitalAddress" type="text" class="form-control" placeholder="Enter Address" asp-for="Address" required />
                    </div>
                    <div class="col-md-3 px-2">
                        <label class="form-label">Enter Email Id</label>
                        <input id="txtEmail" type="email" class="form-control" placeholder="HospitalName@gmail.com" asp-for="Email" required />
                    </div>
                    <div class="col-md-3 px-2">
                        <label class="form-label">Enter Contact Number</label>
                        <input id="txtContectNumber" type="tel" pattern="[0-9]{10}" class="form-control" placeholder="9893*******" asp-for="ContactNumber" maxlength="10" required />
                    </div>
                </div>
                <div class="row px-4">
                    <div class="form-check">
                        <input class="form-check-input fs-5" asp-for="IsActive" type="checkbox">
                        <label class="form-check-label">Is Active</label>

                    </div>
                </div>
                <div class="row px-3">
                    <div class="col-md-12 text-center">
                        <hr />
                        <button type="submit" id="btnSave" class="btn btn-success btn-border w-lg btn-border">Save</button>
                        <button type="reset" class="btn btn-danger px-5">Clear</button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
<script src="~/dist/jquery-3.7.1.min.js"></script>
<script>
  
    <script>
             $(document).ready(function () {
        $("#btnSave").click(function (event) {
            event.preventDefault(); // Prevent default form submission
            let errormsg = "";
           if (!$("#txtHospitalName").val()) errormsg += "Hospital Name is required.\n";
            if (!$("#hospitalTypeDropdown").val()) errormsg += "Hospital Type is required.\n";
            if (!$("#txtOwnerName").val()) errormsg += "Owner Name is required.\n";
            if (!$("#txtMedicalLicenseNumber").val()) errormsg += "Medical License Number is required.\n";
            if (!$("#txtStaffCount").val()) errormsg += "Staff Count is required.\n";
            if (!$("#HospitalAddress").val()) errormsg += "Hospital Address is required.\n";
            if (!$("#txtEmail").val()) errormsg += "Email is required.\n";
            if (!$("#txtContectNumber").val()) errormsg += "Contact Number is required.\n";
            if (errormsg !== "") {
                Swal.fire({
                    icon: 'error',
                    title: 'Validation Error',
                    text: errormsg
                });
                return; // Stop further execution
            }
            Swal.fire({
                title: 'Do you want to Save the Record?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085D6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes!',
                cancelButtonText: 'No'
            }).then((result) => {
                if (result.isConfirmed) {
                    $("#formCreate").submit();
                }
            });
        });
    });






</script>
