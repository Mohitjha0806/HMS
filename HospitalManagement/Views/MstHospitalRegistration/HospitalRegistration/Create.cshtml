@{
    Layout = "~/Views/Shared/_MainMaster.cshtml";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Register Your Hospital</h3>
    </div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div class="form-group">
                <div class="row px-3">
                    <div class="col-md-3 px-2">
                        <label class="form-label">Enter Hospital Name</label>
                        <input type="text" class="form-control" id="txtHospitalName" placeholder="Enter Name" />
                    </div>
                    <div class="col-md-3 px-2">
                        <label class="form-label">Select Hospital Type</label>
                        <select class="form-select" id="DDlHospitalType">
                            <option selected>Choose...</option>
                            <option value="1">General Hospital</option>
                            <option value="2">Specialized Hospital</option>
                            <option value="3">Multi-specialty Hospital</option>
                            <option value="4">Government Hospital</option>
                        </select>
                    </div>
                    <div class="col-md-3 px-2">
                        <label class="form-label">Enter Owner Name</label>
                        <input type="text" class="form-control" id="txtOwnerName" placeholder="Owner Name" />
                    </div>
                    <div class="col-md-3 px-2">
                        <label class="form-label">Enter Medical License Number</label>
                        <input type="text" class="form-control" placeholder="Medical License Number" />
                    </div>
                </div>
                <div class="row px-3">
                    <div class="col-md-3 px-2">
                        <label class="form-label">Enter Staff Count</label>
                        <input type="number" min="0" max="50" maxlength="2" class="form-control" placeholder="Enter Count" />
                    </div>
                    <div class="col-md-3 px-2">
                        <label class="form-label">Enter Hospital Address</label>
                        <input type="text" class="form-control" placeholder="Enter Address" />
                    </div>
                    <div class="col-md-3 px-2">
                        <label class="form-label">Enter Email Id</label>
                        <input type="text" class="form-control" placeholder="HospitalName@gmial.com" />
                    </div>
                    <div class="col-md-3 px-2">
                        <label class="form-label">Enter Contect Number</label>
                        <input type="text" class="form-control" placeholder="9893******" />
                    </div>
                </div>
                <div class="row px-3">
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-sm btn-success">Save</button>
                        <button type="reset" class="btn btn-danger">Clear</button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>


