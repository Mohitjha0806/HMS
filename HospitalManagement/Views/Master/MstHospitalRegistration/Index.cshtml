@{
    Layout = "~/Views/Shared/_MainMaster.cshtml";
}
@model List<HospitalManagement.Entities.ViewModel.MstHospitalRegistrationVM>
<link href="~/datatable/css/datatables.datatables.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
<div class="card card-border-primary card">
    <div class="card-header">
        <div class="row px-2">
            <div class="col-md-6">
                <h4 class="card-title">
                    Hospitals List
                </h4>
            </div>
            <div class="col-md-6 text-end">
                <a asp-action="Create" asp-controller="MstHospitalRegistration" class="btn btn-primary shadow sharp me-1">
                    <i class="fa-solid fa-plus"></i>&nbsp;&nbsp;Add Hospital
                </a>
            </div>
        </div>
    </div>
    <div class="card-body">
        <div class="row px-3">
            <div class="col-md-12">
                <div class="table-responsive">

                    <table id="hospitalTable" class="table table-hover table-striped table-bordered text-center align-middle">
                        <thead class="table-primary">
                            <tr>
                                <th class="text-center">S.No.</th>
                                <th class="text-center">Hospital Name</th>
                                <th class="text-center">Type</th>
                                <th class="text-center">Owner</th>
                                <th class="text-center">License No.</th>
                                <th class="text-center">Capacity</th>
                                <th class="text-center">Division Name</th>
                                <th class="text-center">District Name</th>
                                <th class="text-center">Block Name</th>
                                <th class="text-center">Address</th>
                                <th class="text-center">Email</th>
                                <th class="text-center">Contact</th>
                                <th class="text-center">IsActive</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Count > 0)
                            {
                                int serialNo = 1;
                                foreach (var hospital in Model)
                                {
                                    <tr>
                                        <td class="text-center">@serialNo</td>
                                        <td class="text-center">@hospital.HospitalName</td>
                                        <td class="text-center">@hospital.HospitalTypeName</td>
                                        <td class="text-center">@hospital.OwnerName</td>
                                        <td class="text-center">@hospital.MedicalLicenseNumber</td>
                                        <td class="text-center">@hospital.StaffCount</td>
                                        <td class="text-center">@hospital.DivisionName</td>
                                        <td class="text-center">@hospital.DistrictName</td>
                                        <td class="text-center">@hospital.BlockName</td>
                                        <td class="text-center">@hospital.Address</td>
                                        <td class="text-center">@hospital.Email</td>
                                        <td class="text-center">@hospital.ContactNumber</td>
                                        <td class="text-center">
                                            @if (hospital.IsActive)
                                            {
                                                <span class="badge text-bg-success">Yes</span>
                                            }
                                            else
                                            {
                                                <span class="badge text-bg-danger">No</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="d-flex gap-2">
                                                <button class="btn btn-sm btn-primary" data-id="@hospital.HospitalId" onclick="myCustomEdit(this)">
                                                    <i class="fa-solid fa-pen-to-square"></i>
                                                </button>
                                                <button class="btn btn-sm btn-danger" data-id="@hospital.HospitalId" onclick="myCustomDeletet(this)"><i class="fa-solid fa-trash-can"></i></button>
                                            </div>
                                        </td>
                                    </tr>
                                    serialNo++;
                                }
                            }
                            else
                            {
                                <div class="row">
                                    <h6 colspan="10" class="text-center">No hospitals found</h6>
                                </div>


                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="~/dist/jquery-3.7.1.min.js"></script>
<script src="~/datatable/js/datatables.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<script>
    $(document).ready(function () {
        $('#hospitalTable').DataTable();
    });
</script>

<script>
    function myCustomEdit(button) {
        var hospitalId = button.getAttribute("data-id");
        console.log("Hospital ID:", hospitalId);
        window.location.href = '@Url.Action("Edit", "MstHospitalRegistration", new { hospitalId = "ID" })'.replace("ID", hospitalId);
    }

    function myCustomDeletet(button) {
        var hospitalId = button.getAttribute("data-id");
        console.log("Hospital ID:", hospitalId);
        window.location.href = '@Url.Action("Delete", "MstHospitalRegistration", new { hospitalId = "ID" })'.replace("ID", hospitalId);
    }
</script>
